---
import { site, checkoutUrl } from "../config";

const macUrl = checkoutUrl("mac");
const winUrl = checkoutUrl("windows");
---

<section class="get" id="get">
  <div class="wrap">
    <p class="kicker"><span class="kicker__dot"></span>A copy for your desk</p>
    <h2 class="display">Keep it nearby. Pay once.</h2>
    <p class="lede">
      {site.price.label} one time, macOS or Windows — not both.
      {site.price.updates}. After payment, Lemon Squeezy emails your license
      key and that OS’s installer. First launch needs the internet once.
    </p>
    <div class="ticket">
      <p class="ticket__price">{site.price.label}</p>
      <p class="ticket__sub">one-time · one computer · one OS</p>
      <ul>
        <li>Unique license key, emailed to you</li>
        <li>Activate on first run, then fully offline</li>
        <li>{site.price.updates}</li>
      </ul>
      <div class="os-row">
        {
          macUrl ? (
            <a class="btn btn--primary" href={macUrl} data-download-card="mac">
              macOS
            </a>
          ) : (
            <button
              class="btn btn--primary"
              type="button"
              data-open-purchase="mac"
              data-download-card="mac"
            >
              macOS
            </button>
          )
        }
        {
          winUrl ? (
            <a class="btn btn--primary" href={winUrl} data-download-card="windows">
              Windows
            </a>
          ) : (
            <button
              class="btn btn--primary"
              type="button"
              data-open-purchase="windows"
              data-download-card="windows"
            >
              Windows
            </button>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .get {
    padding: clamp(48px, 8vw, 88px) 0;
    background: var(--band);
    text-align: center;
  }

  .wrap {
    display: grid;
    justify-items: center;
    gap: 14px;
  }

  .display {
    font-size: clamp(1.9rem, 4vw, 3rem);
  }

  .lede {
    text-align: center;
  }

  .ticket {
    margin-top: 12px;
    width: min(100%, 440px);
    background: #fff;
    border-radius: 28px;
    padding: 32px 28px;
    display: grid;
    gap: 10px;
    justify-items: center;
  }

  .ticket__price {
    margin: 0;
    font-size: 3.2rem;
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .ticket__sub,
  .ticket li {
    color: var(--text-soft);
    font-size: 0.95rem;
  }

  ul {
    margin: 8px 0 4px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
  }

  .os-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    width: 100%;
    margin-top: 8px;
  }

  .os-row .btn {
    width: 100%;
  }

  .os-row [data-download-card].is-likely {
    box-shadow: 0 0 0 2px rgba(91, 159, 224, 0.45);
  }
</style>
