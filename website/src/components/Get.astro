---
import { site } from "../config";

const mac = site.downloads.mac;
const win = site.downloads.windows;
---

<section class="get" id="get">
  <div class="wrap">
    <p class="kicker"><span class="kicker__dot"></span>A copy for your desk</p>
    <h2 class="display">Keep it nearby. It’s free.</h2>
    <p class="lede">
      Download for macOS or Windows. No account and no license key. The app
      stays on this computer.
    </p>
    <div class="ticket">
      <p class="ticket__price">{site.price.label}</p>
      <p class="ticket__sub">macOS and Windows</p>
      <ul>
        <li>No account and no license key</li>
        <li>Stays on this computer</li>
        <li>Camera frames never leave the machine</li>
      </ul>
      <div class="os-row">
        <a class="btn btn--primary" href={mac.href} data-download-card="mac">
          macOS
        </a>
        <a class="btn btn--primary" href={win.href} data-download-card="windows">
          Windows
        </a>
      </div>
      <p class="ticket__files">
        EyesRhythm {site.version}. Your browser saves {mac.file} ({mac.size}) or{" "}
        {win.file} ({win.size}). Drag the Mac app into Applications. On Windows,
        run Setup.
      </p>
    </div>
    <p class="get__machine">{site.recommendedMachine}</p>
  </div>
</section>

<style>
  .get {
    padding: clamp(48px, 8vw, 88px) 0;
    background: var(--band);
    text-align: center;
  }

  .wrap {
    display: grid;
    justify-items: center;
    gap: 14px;
  }

  .display {
    font-size: clamp(1.9rem, 4vw, 3rem);
  }

  .lede {
    text-align: center;
  }

  .ticket {
    margin-top: 12px;
    width: min(100%, 440px);
    background: #fff;
    border-radius: 28px;
    padding: 32px 28px;
    display: grid;
    gap: 10px;
    justify-items: center;
  }

  .ticket__price {
    margin: 0;
    font-size: 3.2rem;
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .ticket__sub,
  .ticket li,
  .ticket__files {
    color: var(--text-soft);
    font-size: 0.95rem;
  }

  .ticket__files {
    margin: 4px 0 0;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  ul {
    margin: 8px 0 4px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
  }

  .os-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    width: 100%;
    margin-top: 8px;
  }

  .os-row .btn {
    width: 100%;
  }

  .os-row [data-download-card].is-likely {
    box-shadow: 0 0 0 2px rgba(91, 159, 224, 0.45);
  }

  .get__machine {
    margin: 4px 0 0;
    max-width: 28rem;
    text-align: center;
    color: var(--text-soft);
    font-size: 0.92rem;
  }
</style>
