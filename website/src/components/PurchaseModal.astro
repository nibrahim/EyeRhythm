---
import { site, checkoutReady, checkoutUrl } from "../config";

const macUrl = checkoutUrl("mac");
const winUrl = checkoutUrl("windows");
const live = checkoutReady();
---

<dialog class="modal" id="purchase-dialog" aria-labelledby="purchase-title">
  <div class="modal__inner">
    <div class="modal__head">
      <div>
        <p class="kicker"><span class="kicker__dot"></span>{site.cta}</p>
        <h2 id="purchase-title">Choose one computer</h2>
      </div>
      <button class="modal__close" type="button" data-close-purchase aria-label="Close">
        ×
      </button>
    </div>
    <p class="muted">
      {site.price.label} one time. Pick macOS or Windows — not both. Lemon
      Squeezy takes payment, emails a unique license key to the address you
      give at checkout, and sends that OS’s installer.
    </p>
    <div class="modal__price">
      <strong>{site.price.label}</strong>
      <span class="muted">one-time · one OS</span>
    </div>

    <form id="purchase-form">
      <p class="os-label">Which copy?</p>
      <div class="os-picks" role="radiogroup" aria-label="Operating system">
        <label class="os-pick">
          <input type="radio" name="platform" value="mac" data-checkout={macUrl} />
          <span class="os-pick__name">macOS</span>
          <span class="os-pick__meta">Mac app + license key</span>
        </label>
        <label class="os-pick">
          <input type="radio" name="platform" value="windows" data-checkout={winUrl} />
          <span class="os-pick__name">Windows</span>
          <span class="os-pick__meta">Windows app + license key</span>
        </label>
      </div>
      <p class="form-error" data-form-error>
        Choose macOS or Windows. A purchase is for one operating system.
      </p>
      {
        live ? (
          <button class="btn btn--primary" type="submit" data-checkout-go>
            Continue to checkout
          </button>
        ) : (
          <button class="btn btn--primary" type="button" disabled>
            Checkout links not connected yet
          </button>
        )
      }
    </form>
    {
      live ? null : (
        <p class="muted checkout-hint">
          Checkout is not taking payment yet. When the store is connected,
          this button will send you to Lemon Squeezy for macOS or Windows.
        </p>
      )
    }
  </div>
</dialog>
