---
import { site } from "../config";

const mac = site.downloads.mac;
const win = site.downloads.windows;
---

<dialog class="modal" id="download-dialog" aria-labelledby="download-title">
  <div class="modal__inner">
    <div class="modal__head">
      <div>
        <p class="kicker"><span class="kicker__dot"></span>{site.cta}</p>
        <h2 id="download-title">Pick your computer</h2>
      </div>
      <button class="modal__close" type="button" data-close-download aria-label="Close">
        ×
      </button>
    </div>
    <p class="muted">
      Free for macOS and Windows. EyesRhythm {site.version}. No account and no
      license key. {site.recommendedMachine}
    </p>
    <div class="modal__price">
      <strong>{site.price.label}</strong>
      <span class="muted">both operating systems</span>
    </div>
    <div class="os-row">
      <a class="btn btn--primary" href={mac.href} data-download-card="mac">
        macOS
        <small>{mac.file}</small>
      </a>
      <a class="btn btn--primary" href={win.href} data-download-card="windows">
        Windows
        <small>{win.file}</small>
      </a>
    </div>
  </div>
</dialog>

<style>
  .os-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 8px;
  }

  .os-row .btn {
    width: 100%;
    display: grid;
    gap: 4px;
    justify-items: center;
  }

  .os-row small {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0;
    opacity: 0.85;
  }
</style>
