---
const slides = [
  {
    label: "Live 5-minute graph",
    caption: "See the last 5 minutes of your blink rhythm on a live graph.",
    image: "/images/hero/trace.png",
    alt: "EyesRhythm Trace view showing a five-minute live ORI graph",
  },
  {
    label: "Avatars",
    caption: "Pick a look that fits you. Atlas, Lumen, Vesper, Lens, Trace, or Poise.",
    image: "/images/hero/avatars.png",
    alt: "EyesRhythm Lumen avatar with Atlas, Vesper, Lens, Trace, and Poise in the picker",
  },
  {
    label: "Poise",
    caption: "Turn your head through the day. Green is where you looked, red is still waiting, so the neck and shoulders are not stuck in one pose.",
    image: "/images/hero/poise.png",
    alt: "EyesRhythm Poise view with a face grid and a red-to-green direction dial",
  },
  {
    label: "Several cameras",
    caption: "Use more than one camera if you work across several screens.",
    image: "/images/hero/cameras.png",
    alt: "EyesRhythm camera setting with Hybrid multi-camera mode selected",
  },
  {
    label: "Glow or sound",
    caption: "Get a quiet glow, a sound, or a click when you need a nudge.",
    image: "/images/hero/alerts.png",
    alt: "EyesRhythm companion with Beep, Visual, and Practice controls",
  },
  {
    label: "Smart FPS",
    caption: "The camera slows down when you look away, so it uses less CPU.",
    image: "/images/hero/fps.png",
    alt: "EyesRhythm dashboard highlighting the auto FPS camera pipeline card",
  },
  {
    label: "Day, week, month",
    caption: "Monitor your progress. See how you did today, this week, and this month.",
    image: "/images/hero/reports.png",
    alt: "EyesRhythm daily ORI report chart with weekly and monthly tabs",
  },
];
---

<section class="hero" id="top">
  <div class="hero__inner">
    <p class="kicker"><span class="kicker__dot"></span>On-device · No cloud</p>
    <h1 class="display">More than just a blink rate detector.</h1>
    <p class="lede">
      EyesRhythm uses your webcam to score how often and how steadily you blink
      on long screen days. Poise shows which way you turned your head, so the
      neck and shoulders get a change of direction. No account, and no video
      leaving your machine.
    </p>

    <div class="hero__stage" data-hero-stage>
      {
        slides.map((slide, i) => (
          <div
            class:list={["slide", i === 0 && "is-on"]}
            data-slide={i}
            id={`hero-slide-${i}`}
            role="tabpanel"
            aria-labelledby={`hero-tab-${i}`}
            aria-hidden={i === 0 ? "false" : "true"}
          >
            <figure class="shot">
              <img
                src={slide.image}
                alt={slide.alt}
                width="840"
                height="640"
                loading={i === 0 ? "eager" : "lazy"}
              />
            </figure>
          </div>
        ))
      }
    </div>

    <div class="hero__below">
      <div
        class="hero__rail"
        role="tablist"
        aria-label="App views"
        data-hero-rail
        style="--i: 0; --n: 7;"
      >
        <span class="hero__rail-track" aria-hidden="true"></span>
        <span class="hero__rail-thumb" data-hero-thumb aria-hidden="true"></span>
        {
          slides.map((slide, i) => (
            <button
              type="button"
              role="tab"
              id={`hero-tab-${i}`}
              data-hero-dash={i}
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`hero-slide-${i}`}
              tabindex={i === 0 ? "0" : "-1"}
              aria-label={slide.label}
              data-caption={slide.caption}
            ></button>
          ))
        }
      </div>
      <p class="hero__caption" data-hero-caption>{slides[0].caption}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    background: #fff;
    padding: 20px var(--gutter) 8px;
    scroll-margin-top: calc(var(--nav-h) + 10px);
  }

  .hero__inner {
    max-width: 760px;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
  }

  .display {
    max-width: 11em;
    width: 100%;
    min-width: 0;
    text-align: center;
    font-size: clamp(2.4rem, 5.4vw, 3.8rem);
  }

  .lede {
    text-align: center;
    max-width: 36rem;
    width: 100%;
  }

  .hero__stage {
    position: relative;
    flex: 0 0 auto;
    width: min(100%, 520px);
    height: clamp(340px, 72vw, 480px);
    background: #fff;
    margin-top: 8px;
    overflow: hidden;
  }

  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition: opacity 0.28s ease, transform 0.28s ease;
    display: grid;
    place-items: center;
    background: #fff;
    min-height: 0;
    overflow: hidden;
  }

  .slide.is-on {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  .shot {
    margin: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    overflow: hidden;
  }

  .shot img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 18px;
  }

  .hero__below {
    width: 100%;
    max-width: 32rem;
    min-height: 5.6rem;
    padding-top: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    background: #fff;
  }

  .hero__rail {
    --i: 0;
    --n: 7;
    --cell: 32px;
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--n), var(--cell));
    width: calc(var(--n) * var(--cell));
    height: 36px;
    align-items: center;
    justify-content: center;
  }

  .hero__rail-track {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 50%;
    height: 1px;
    border-radius: 99px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(91, 159, 224, 0.28) 12%,
      rgba(91, 159, 224, 0.28) 88%,
      transparent
    );
    pointer-events: none;
  }

  .hero__rail-thumb {
    position: absolute;
    left: 0;
    top: 50%;
    width: 16px;
    height: 3px;
    border-radius: 99px;
    background: #5b9fe0;
    box-shadow: 0 0 10px 1px rgba(91, 159, 224, 0.7),
      0 0 22px 4px rgba(91, 159, 224, 0.28);
    transform: translate(
      calc(var(--i) * var(--cell) + var(--cell) / 2 - 50%),
      -50%
    );
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
    z-index: 1;
  }

  .hero__rail button {
    position: relative;
    z-index: 1;
    width: var(--cell);
    height: 36px;
    background: transparent;
    display: grid;
    place-items: center;
  }

  .hero__rail button::before {
    content: "";
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(91, 159, 224, 0.28);
    box-shadow: 0 0 0 0 rgba(91, 159, 224, 0);
    transition: background 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }

  .hero__rail button:hover::before,
  .hero__rail button:focus-visible::before {
    background: rgba(91, 159, 224, 0.7);
    transform: scale(1.2);
  }

  .hero__rail button[aria-selected="true"]::before {
    background: #5b9fe0;
    box-shadow: 0 0 8px 1px rgba(91, 159, 224, 0.85);
    transform: scale(1.15);
  }

  .hero__rail button:focus-visible {
    outline: none;
  }

  .hero__rail button:focus-visible::after {
    content: "";
    position: absolute;
    inset: 6px 4px;
    border-radius: 8px;
    box-shadow: 0 0 0 2px rgba(91, 159, 224, 0.45);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__rail-thumb {
      transition: none;
    }
  }

  .hero__caption {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--text-soft);
    min-height: 2.9em;
  }
</style>
