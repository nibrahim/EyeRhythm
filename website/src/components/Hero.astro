---
import { site } from "../config";

const slides = [
  {
    label: "Trace Rhythm",
    caption: "Watch the last minutes of your blink cadence as a quiet line.",
  },
  {
    label: "Avatars",
    caption: "Pick a face that fits you — Atlas, Lumen, Vesper, Lens, or Trace.",
  },
  {
    label: "A gentle beep",
    caption:
      "When ORI stays low, a soft sound asks you to pause and blink slowly — do not force it.",
  },
  {
    label: "Practice",
    caption: "A two-minute coach so blinking feels natural again.",
  },
  {
    label: "A few settings",
    caption: "Tune the alert, look angle, and blink sensitivity if you need to.",
  },
  {
    label: "Feel the difference",
    caption:
      "If it helps you, a small copy helps the builder. Copies will go out after payment is ready.",
  },
];
---

<section class="hero" id="top">
  <div class="hero__inner">
    <p class="kicker"><span class="kicker__dot"></span>On-device · No cloud</p>
    <h1 class="display">A quiet rhythm for long screen days.</h1>
    <p class="lede">
      A private blink companion for the desk. No account. No video leaving
      this machine.
    </p>
    <div class="btn-row">
      <button class="btn btn--primary" type="button" data-open-purchase>
        {site.cta}
      </button>
    </div>

    <div class="hero__stage" data-hero-stage>
      <!-- 1. Trace -->
      <div class="slide is-on" data-slide="0">
        <div class="win">
          <div class="win__bar"><i></i><i></i><i></i><span>Trace</span></div>
          <svg class="trace" viewBox="0 0 360 180" aria-hidden="true">
            <rect x="36" y="28" width="308" height="72" fill="rgba(91,159,224,0.1)"></rect>
            <line x1="36" y1="100" x2="344" y2="100" stroke="#e05a52" stroke-dasharray="4 3" stroke-width="1.2"></line>
            <path
              d="M36 70 C70 62 90 78 120 58 C150 40 170 86 200 72 C230 58 250 48 280 66 C310 84 330 52 344 46"
              fill="none"
              stroke="#3d8fd6"
              stroke-width="2.2"
              stroke-linecap="round"></path>
            <circle cx="90" cy="72" r="3" fill="#f0a040"></circle>
            <circle cx="168" cy="64" r="3" fill="#f0a040"></circle>
            <circle cx="252" cy="54" r="3" fill="#f0a040"></circle>
            <text x="40" y="24" font-size="11" fill="#5a6f82">ORI</text>
            <text x="300" y="172" font-size="10" fill="#8a9aab">−5 min</text>
            <text x="36" y="172" font-size="10" fill="#8a9aab">now</text>
          </svg>
        </div>
      </div>

      <!-- 2. Avatars -->
      <div class="slide" data-slide="1">
        <div class="avatars">
          <figure>
            <svg viewBox="0 0 220 280" aria-hidden="true">
              <path d="M110 30 C154 30 186 72 186 118 C186 158 166 190 146 204 L148 246 C148 262 132 270 110 270 C88 270 72 262 72 246 L74 204 C54 190 34 158 34 118 C34 72 66 30 110 30Z" fill="#B89A7A"></path>
              <ellipse cx="84" cy="110" rx="12" ry="5.5" fill="#1A2A38"></ellipse>
              <ellipse cx="136" cy="110" rx="12" ry="5.5" fill="#1A2A38"></ellipse>
            </svg>
            <figcaption>Atlas</figcaption>
          </figure>
          <figure>
            <svg viewBox="0 0 220 280" aria-hidden="true">
              <path d="M110 36 C150 36 178 74 178 118 C178 154 162 186 146 200 L146 244 C146 260 130 268 110 268 C90 268 74 260 74 244 L74 200 C58 186 42 154 42 118 C42 74 70 36 110 36Z" fill="#E0C8B8"></path>
              <path d="M50 100 C50 52 78 28 110 28 C142 28 170 52 170 100 C166 72 148 52 110 50 C72 52 54 72 50 100Z" fill="#2A201C"></path>
              <ellipse cx="86" cy="112" rx="12" ry="5.5" fill="#3A2A28"></ellipse>
              <ellipse cx="134" cy="112" rx="12" ry="5.5" fill="#3A2A28"></ellipse>
            </svg>
            <figcaption>Lumen</figcaption>
          </figure>
          <figure>
            <svg viewBox="0 0 220 280" aria-hidden="true">
              <path d="M110 28 C148 28 182 64 184 112 C186 158 166 194 148 208 L150 246 C150 262 132 270 110 270 C88 270 70 262 70 246 L72 208 C54 194 34 158 36 112 C38 64 72 28 110 28Z" fill="#8FB8D0"></path>
              <ellipse cx="82" cy="112" rx="14" ry="8" fill="#0E1A28"></ellipse>
              <ellipse cx="138" cy="112" rx="14" ry="8" fill="#0E1A28"></ellipse>
            </svg>
            <figcaption>Vesper</figcaption>
          </figure>
        </div>
        <p class="chips"><span>Lens</span><span>Trace</span></p>
      </div>

      <!-- 3. Gentle beep -->
      <div class="slide" data-slide="2">
        <article class="card-slide soft">
          <svg width="72" height="72" viewBox="0 0 72 72" aria-hidden="true">
            <circle cx="36" cy="36" r="34" fill="#e4eef8"></circle>
            <path d="M28 28 v16 h8 l12 10 V18 L36 28 Z" fill="#2f78c4"></path>
            <path d="M50 28 c6 4 6 12 0 16" fill="none" stroke="#5b9fe0" stroke-width="2.4" stroke-linecap="round"></path>
          </svg>
          <p>A quiet cue — not a lecture.</p>
        </article>
      </div>

      <!-- 4. Practice -->
      <div class="slide" data-slide="3">
        <div class="win win--practice">
          <div class="win__bar"><i></i><i></i><i></i><span>Practice</span></div>
          <svg class="practice-art" viewBox="0 0 360 200" aria-hidden="true">
            <line x1="180" y1="100" x2="300" y2="36" stroke="#5b9fe0" stroke-width="2"></line>
            <circle cx="180" cy="100" r="5" fill="#1e2c3a"></circle>
            <circle cx="300" cy="36" r="16" fill="#5b9fe0"></circle>
            <circle cx="306" cy="30" r="4" fill="white" opacity="0.85"></circle>
          </svg>
        </div>
      </div>

      <!-- 5. Settings -->
      <div class="slide" data-slide="4">
        <div class="win">
          <div class="win__bar"><i></i><i></i><i></i><span>Settings</span></div>
          <ul class="tunes">
            <li><span>ORI alert</span><b></b></li>
            <li><span>Look angle</span><b></b></li>
            <li><span>Blink feel</span><b></b></li>
          </ul>
        </div>
      </div>

      <!-- 6. Feel the difference -->
      <div class="slide" data-slide="5">
        <article class="card-slide gift">
          <p class="gift__price">{site.price.label}</p>
          <p>one time · Mac and Windows</p>
          <button class="btn btn--primary" type="button" data-open-purchase>
            {site.cta}
          </button>
        </article>
      </div>
    </div>

    <div class="hero__pager" role="tablist" aria-label="App views">
      {
        slides.map((slide, i) => (
          <button
            type="button"
            role="tab"
            data-hero-dash={i}
            aria-selected={i === 0 ? "true" : "false"}
            aria-label={slide.label}
            data-caption={slide.caption}
          ></button>
        ))
      }
    </div>
    <p class="hero__caption" data-hero-caption>{slides[0].caption}</p>
  </div>
</section>

<style>
  .hero {
    background: #fff;
    padding: 20px var(--gutter) 8px;
    scroll-margin-top: calc(var(--nav-h) + 10px);
  }

  .hero__inner {
    max-width: 760px;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
  }

  .display {
    max-width: 8.6em;
    width: 100%;
    min-width: 0;
    text-align: center;
    font-size: clamp(2.4rem, 5.4vw, 3.8rem);
  }

  .lede {
    text-align: center;
    max-width: 34rem;
    width: 100%;
  }

  .btn-row {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .hero__stage {
    position: relative;
    width: 100%;
    height: 300px;
    display: grid;
    place-items: center;
    margin-top: 8px;
  }

  .slide {
    grid-area: 1 / 1;
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition: opacity 0.28s ease, transform 0.28s ease;
    width: 100%;
    display: grid;
    justify-items: center;
  }

  .slide.is-on {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  .win {
    width: min(100%, 420px);
    background: #e8eef6;
    border: 1px solid rgba(30, 48, 72, 0.1);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 18px 40px rgba(30, 48, 72, 0.08);
    text-align: left;
  }

  .win__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 12px;
    background: #f6f8fb;
    font-size: 0.72rem;
    color: var(--text-soft);
  }

  .win__bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff5f57;
  }
  .win__bar i:nth-child(2) {
    background: #febc2e;
  }
  .win__bar i:nth-child(3) {
    background: #28c840;
  }
  .win__bar span {
    margin-left: auto;
  }

  .trace {
    display: block;
    width: 100%;
    height: 180px;
    background: linear-gradient(180deg, #f7fafc, #eef4fa);
  }

  .avatars {
    display: flex;
    gap: 10px;
    justify-content: center;
    align-items: end;
  }

  .avatars figure {
    margin: 0;
    width: 92px;
  }

  .avatars svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .avatars figcaption {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-soft);
  }

  .chips {
    display: flex;
    gap: 8px;
    margin: 8px 0 0;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--blue-deep);
  }

  .chips span {
    padding: 4px 10px;
    border-radius: 999px;
    background: #e4eef8;
  }

  .card-slide {
    width: min(100%, 380px);
    min-height: 240px;
    border-radius: 28px;
    padding: 28px;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 10px;
    background: var(--band);
  }

  .soft p,
  .gift p {
    color: var(--text-soft);
    margin: 0;
  }

  .gift .gift__price {
    color: var(--text);
  }

  .practice-art {
    display: block;
    width: 100%;
    height: 200px;
    background: #f7fafc;
  }

  .tunes {
    list-style: none;
    margin: 0;
    padding: 18px 20px 22px;
    display: grid;
    gap: 14px;
  }

  .tunes li {
    display: grid;
    gap: 6px;
    font-size: 0.82rem;
    color: var(--text-soft);
  }

  .tunes b {
    display: block;
    height: 6px;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--blue) 55%, rgba(91, 159, 224, 0.2) 55%);
  }

  .tunes li:nth-child(2) b {
    background: linear-gradient(90deg, var(--blue) 35%, rgba(91, 159, 224, 0.2) 35%);
  }

  .tunes li:nth-child(3) b {
    background: linear-gradient(90deg, var(--blue) 42%, rgba(91, 159, 224, 0.2) 42%);
  }

  .gift__price {
    font-size: 3rem;
    font-weight: 600;
    letter-spacing: -0.05em;
    color: var(--text);
  }

  .hero__pager {
    display: flex;
    gap: 6px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .hero__pager button {
    width: 28px;
    height: 22px;
    border-radius: 99px;
    background: transparent;
    position: relative;
  }

  .hero__pager button::after {
    content: "";
    position: absolute;
    left: 2px;
    right: 2px;
    top: 8px;
    height: 6px;
    border-radius: 99px;
    background: rgba(0, 0, 0, 0.16);
  }

  .hero__pager button[aria-selected="true"]::after {
    left: 0;
    right: 0;
    background: #1d1d1f;
  }

  .hero__caption {
    margin: 0 0 16px;
    font-size: 0.92rem;
    color: var(--text-soft);
    max-width: 32rem;
    min-height: 2.6em;
  }
</style>
