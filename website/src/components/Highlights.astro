---
const tiles = [
  {
    title: "Poise",
    body: "A dial of where your head went today, in 30° slices. Green is where you looked. Red is a direction you skipped. Turning through those directions lets the neck and shoulders ease, then you come back to the screen.",
    tone: "lavender",
  },
  {
    title: "Live blink rate",
    body: "A webcam blink rate detector in a compact window. ORI, screen time, and look angle stay in view. Rate and regularity sit on Trace.",
    tone: "sage",
  },
  {
    title: "Visual or Sound",
    body: "Alert stays on. Visual is a quiet orange pulse. Click A for Sound. Beep (B) is a separate click on each blink.",
    tone: "peach",
  },
  {
    title: "Beep on each blink",
    body: "A tighter feedback loop. Optional click on every counted blink.",
    tone: "sun",
  },
  {
    title: "Practice",
    body: "A countdown, then a guided two-minute session that paces blinks so the habit is easier to feel.",
    tone: "mint",
  },
  {
    title: "Dockable GUI",
    body: "Open Settings and Reports beside the companion, then hide the panel to keep the window small.",
    tone: "sky",
  },
  {
    title: "Built for the desk",
    body: "A small window next to your work. Camera preview stays put-away unless you open Lens.",
    tone: "mist",
  },
];
---

<section class="highlights" id="highlights">
  <div class="wrap">
    <div class="rail-head">
      <div>
        <p class="kicker"><span class="kicker__dot"></span>Get the highlights</p>
        <h2 class="display">A companion, not another dashboard.</h2>
      </div>
      <div class="rail-nav">
        <button type="button" data-rail-prev aria-label="Previous">‹</button>
        <button type="button" data-rail-next aria-label="Next">›</button>
      </div>
    </div>
  </div>
  <div class="rail-bleed">
    <div class="rail" data-rail>
      {
        tiles.map((tile) => (
          <article class:list={["tile", tile.tone]}>
            <h3>{tile.title}</h3>
            <p>{tile.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .highlights {
    padding: clamp(48px, 8vw, 96px) 0;
    background: #fff;
  }

  .rail-bleed {
    padding-left: max(var(--gutter), calc((100vw - var(--wrap)) / 2));
  }

  .rail-bleed .rail {
    padding-right: var(--gutter);
  }

  .display {
    font-size: clamp(1.9rem, 4vw, 3rem);
    margin-top: 10px;
  }

  .tile {
    min-height: 280px;
    padding: 28px;
    border-radius: 28px;
    display: grid;
    align-content: space-between;
  }

  .tile p {
    color: rgba(29, 29, 31, 0.72);
    font-size: 1.02rem;
  }

  .sage {
    background: #b5d4ec;
  }
  .peach {
    background: #f0c8a8;
  }
  .sun {
    background: #f0d878;
  }
  .mint {
    background: #9cc8e8;
  }
  .sky {
    background: #a8ccec;
  }
  .mist {
    background: #d4dce6;
  }
  .lavender {
    background: #c8c0e8;
  }

  @media (min-width: 900px) {
    .rail > * {
      flex-basis: 360px;
    }

    .tile {
      min-height: 340px;
    }
  }
</style>
