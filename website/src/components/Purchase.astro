---
import { site } from "../config";

const mac = site.downloads.mac;
const win = site.downloads.windows;
---

<section class="section" id="purchase">
  <div class="wrap buy">
    <div class="buy__copy">
      <p class="kicker"><span class="kicker__dot"></span>Free, not a subscription</p>
      <h2 class="display">Download it. Keep it on your machine.</h2>
      <p class="lede">
        EyesRhythm is free for macOS and Windows. There is no account and no
        license key. After you install it, nothing phones home.
      </p>
      <ul>
        <li>Free for personal use</li>
        <li>macOS and Windows, each with its own installer</li>
        <li>Blink data stays on the machine</li>
      </ul>
    </div>
    <aside class="card ticket">
      <p class="ticket__kicker">Download</p>
      <p class="ticket__price">
        <strong>{site.price.label}</strong>
        <span>{site.price.cadence}</span>
      </p>
      <p class="ticket__sub">Mac and Windows</p>
      <div class="os-row">
        <a class="btn btn--primary" href={mac.href}>macOS</a>
        <a class="btn btn--primary" href={win.href}>Windows</a>
      </div>
    </aside>
  </div>
</section>

<style>
  .buy {
    display: grid;
    gap: 28px;
    align-items: center;
  }

  .buy__copy {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  ul {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 8px;
    color: var(--text-soft);
  }

  .ticket {
    padding: 28px;
    display: grid;
    gap: 12px;
    justify-items: start;
    background: linear-gradient(180deg, #ffffff, #e4eef8);
  }

  .ticket__kicker {
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-soft);
  }

  .ticket__price {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .ticket__price strong {
    font-size: 3.2rem;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .ticket__price span,
  .ticket__sub {
    color: var(--text-soft);
  }

  .os-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    width: 100%;
  }

  .os-row .btn {
    width: 100%;
  }

  @media (min-width: 860px) {
    .buy {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 48px;
    }
  }
</style>
