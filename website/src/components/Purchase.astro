---
import { site, checkoutUrl } from "../config";

const macUrl = checkoutUrl("mac");
const winUrl = checkoutUrl("windows");
---

<section class="section" id="purchase">
  <div class="wrap buy">
    <div class="buy__copy">
      <p class="kicker"><span class="kicker__dot"></span>A license, not a subscription</p>
      <h2 class="display">Pay once. Keep it on your machine.</h2>
      <p class="lede">
        EyesRhythm is yours to run locally. Pick macOS or Windows at checkout.
        You get a unique key by email. First launch binds it to that computer.
        After that, nothing phones home.
      </p>
      <ul>
        <li>One-time personal use on one computer</li>
        <li>macOS or Windows, not both from one purchase</li>
        <li>Internet once, to activate; blink data stays on the machine</li>
        <li>Supports the work of keeping it quiet and private</li>
      </ul>
    </div>
    <aside class="card ticket">
      <p class="ticket__kicker">Personal license</p>
      <p class="ticket__price">
        <strong>{site.price.label}</strong>
        <span>{site.price.cadence}</span>
      </p>
      <p class="ticket__sub">One OS · no subscription</p>
      <div class="os-row">
        {
          macUrl ? (
            <a class="btn btn--primary" href={macUrl}>macOS</a>
          ) : (
            <button class="btn btn--primary" type="button" data-open-purchase="mac">
              macOS
            </button>
          )
        }
        {
          winUrl ? (
            <a class="btn btn--primary" href={winUrl}>Windows</a>
          ) : (
            <button class="btn btn--primary" type="button" data-open-purchase="windows">
              Windows
            </button>
          )
        }
      </div>
    </aside>
  </div>
</section>

<style>
  .buy {
    display: grid;
    gap: 28px;
    align-items: center;
  }

  .buy__copy {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  ul {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 8px;
    color: var(--text-soft);
  }

  .ticket {
    padding: 28px;
    display: grid;
    gap: 12px;
    justify-items: start;
    background: linear-gradient(180deg, #ffffff, #e4eef8);
  }

  .ticket__kicker {
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-soft);
  }

  .ticket__price {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .ticket__price strong {
    font-size: 3.2rem;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .ticket__price span,
  .ticket__sub {
    color: var(--text-soft);
  }

  .os-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    width: 100%;
  }

  .os-row .btn {
    width: 100%;
  }

  @media (min-width: 860px) {
    .buy {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 48px;
    }
  }
</style>
