---
import { site } from "../config";
---

<section class="section" id="download">
  <div class="wrap">
    <header class="head">
      <p class="kicker"><span class="kicker__dot"></span>Get the app</p>
      <h2 class="display">Download for Mac and Windows. It runs on this computer.</h2>
      <p class="lede">
        Unzip, launch, allow the camera. There is no account to create. You can
        share the file with someone else — they run it locally too.
      </p>
    </header>

    <div class="dl">
      <a
        class="card platform"
        href={site.downloads.mac}
        data-download-card="mac"
        download
      >
        <div class="platform__icon" aria-hidden="true">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none">
            <path
              d="M16.5 12.2c-.1-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.2-2.8.9-3.5.9s-1.8-.8-3-.8c-1.5 0-2.9.9-3.7 2.3-1.6 2.7-.4 6.7 1.1 8.9.8 1.1 1.7 2.3 2.9 2.2 1.2 0 1.6-.7 3-.7s1.8.7 3 .7 2-.1 2.9-2.2c.6-.9 1.1-1.9 1.4-2.9-3.6-1.4-3.6-5.1-3.7-5.1zM14.2 5.6c.6-.8 1.1-1.8.9-2.9-1 .1-2.1.7-2.7 1.5-.6.7-1.1 1.8-.9 2.8 1.1.1 2.1-.6 2.7-1.4z"
              fill="currentColor"></path>
          </svg>
        </div>
        <div>
          <h3>{site.downloads.macLabel}</h3>
          <p>{site.downloads.macHint}</p>
        </div>
        <span class="platform__cta">Download</span>
      </a>

      <a
        class="card platform"
        href={site.downloads.windows}
        data-download-card="windows"
        download
      >
        <div class="platform__icon" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
            <path
              d="M3 5.5 10.2 4.5v6.9H3V5.5zm0 13 7.2 1.1v-6.9H3v5.8zM11.1 4.3 21 2.8v8.6h-9.9V4.3zm9.9 16.9-9.9-1.4v-6.8H21v8.2z"
              fill="currentColor"></path>
          </svg>
        </div>
        <div>
          <h3>{site.downloads.windowsLabel}</h3>
          <p>{site.downloads.windowsHint}</p>
        </div>
        <span class="platform__cta">Download</span>
      </a>
    </div>


  </div>
</section>

<style>
  .head {
    display: grid;
    gap: 16px;
    margin-bottom: 28px;
    justify-items: start;
  }

  .dl {
    display: grid;
    gap: 14px;
  }

  .platform {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 16px;
    align-items: center;
    padding: 22px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.18s var(--ease), border-color 0.18s ease;
  }

  .platform:hover {
    transform: translateY(-2px);
    border-color: rgba(91, 159, 224, 0.45);
  }

  .platform.is-likely {
    border-color: rgba(91, 159, 224, 0.55);
    background: #f7fbfe;
  }

  .platform__icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    background: #e4eef8;
    color: var(--blue-deep);
  }

  .platform p {
    color: var(--text-soft);
    font-size: 0.92rem;
    margin-top: 2px;
  }

  .platform__cta {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--blue-deep);
  }

  .alt {
    margin-top: 16px;
    font-size: 0.88rem;
    color: var(--text-soft);
  }

  .alt code {
    font-size: 0.8em;
    background: rgba(255, 255, 255, 0.7);
    padding: 1px 6px;
    border-radius: 6px;
  }

  @media (min-width: 760px) {
    .dl {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .platform {
      grid-template-columns: auto 1fr;
    }

    .platform__cta {
      grid-column: 2;
    }
  }
</style>
