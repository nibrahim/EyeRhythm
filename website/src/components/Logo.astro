---
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class="er-logo"
>
  <rect x="2" y="2" width="60" height="60" rx="18" fill="#5B9FE0"></rect>
  <path
    d="M27 33 C29.2 27.6 30.8 27.6 32 32 C33.2 36.4 34.8 36.4 37 33"
    stroke="white"
    stroke-width="1.8"
    stroke-linecap="round"
    fill="none"
    opacity="0.92"></path>
  <g transform="rotate(-8 17.5 32)">
    <ellipse
      cx="17.5"
      cy="32"
      rx="8.4"
      ry="6"
      stroke="white"
      stroke-width="2.2"
      fill="rgba(255,255,255,0.16)"></ellipse>
  </g>
  <g transform="rotate(8 46.5 32)">
    <ellipse
      cx="46.5"
      cy="32"
      rx="8.4"
      ry="6"
      stroke="white"
      stroke-width="2.2"
      fill="rgba(255,255,255,0.16)"></ellipse>
  </g>
  <g class="blink-lid">
    <g transform="rotate(-8 17.5 32)">
      <circle cx="19.2" cy="32" r="3.4" fill="#E8F2FA"></circle>
      <circle cx="19.6" cy="32" r="1.65" fill="#1A2A38"></circle>
      <circle cx="20.4" cy="31.2" r="0.7" fill="white" opacity="0.95"></circle>
    </g>
    <g transform="rotate(8 46.5 32)">
      <circle cx="44.8" cy="32" r="3.4" fill="#E8F2FA"></circle>
      <circle cx="44.4" cy="32" r="1.65" fill="#1A2A38"></circle>
      <circle cx="45.2" cy="31.2" r="0.7" fill="white" opacity="0.95"></circle>
    </g>
  </g>
</svg>

<style>
  .er-logo {
    display: block;
    flex-shrink: 0;
    border-radius: 30%;
  }

  .blink-lid {
    transform-origin: 32px 32px;
    animation: lid 3.333s ease-in-out infinite;
  }

  @keyframes lid {
    0%,
    88%,
    100% {
      transform: scaleY(1);
    }
    92% {
      transform: scaleY(0.12);
    }
  }
</style>
