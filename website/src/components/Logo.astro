---
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class="er-logo"
>
  <rect x="2" y="2" width="60" height="60" rx="18" fill="#5B9FE0"></rect>
  <ellipse
    cx="21.5"
    cy="32"
    rx="11"
    ry="7.5"
    stroke="white"
    stroke-width="2.4"
    fill="rgba(255,255,255,0.14)"></ellipse>
  <ellipse
    cx="42.5"
    cy="32"
    rx="11"
    ry="7.5"
    stroke="white"
    stroke-width="2.4"
    fill="rgba(255,255,255,0.14)"></ellipse>
  <g class="blink-lid">
    <circle cx="21.5" cy="32" r="4.2" fill="#E8F2FA"></circle>
    <circle cx="21.5" cy="32" r="2" fill="#1A2A38"></circle>
    <circle cx="22.8" cy="30.7" r="0.85" fill="white" opacity="0.9"></circle>
    <circle cx="42.5" cy="32" r="4.2" fill="#E8F2FA"></circle>
    <circle cx="42.5" cy="32" r="2" fill="#1A2A38"></circle>
    <circle cx="43.8" cy="30.7" r="0.85" fill="white" opacity="0.9"></circle>
  </g>
</svg>

<style>
  .er-logo {
    display: block;
    flex-shrink: 0;
    border-radius: 30%;
  }

  .blink-lid {
    transform-origin: 32px 32px;
    animation: lid 3.333s ease-in-out infinite;
  }

  @keyframes lid {
    0%,
    88%,
    100% {
      transform: scaleY(1);
    }
    92% {
      transform: scaleY(0.12);
    }
  }
</style>
