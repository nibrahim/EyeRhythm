---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Story from "../components/Story.astro";
import Highlights from "../components/Highlights.astro";
import Privacy from "../components/Privacy.astro";
import Get from "../components/Get.astro";
import Faq from "../components/Faq.astro";
import JournalTeaser from "../components/JournalTeaser.astro";
import About from "../components/About.astro";
import { site } from "../config";
import { faqJsonLd } from "../data/faq";
---

<Layout
  title="EyesRhythm — Blink rate detector for Mac and Windows"
  description={site.description}
  jsonLd={faqJsonLd()}
>
  <main id="main">
    <Hero />
    <Story />
    <Highlights />
    <Privacy />
    <Get />
    <Faq />
    <JournalTeaser />
    <About />
  </main>
</Layout>
