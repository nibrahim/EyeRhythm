---
import Legal from "../components/Legal.astro";
import { site } from "../config";
---

<Legal
  kicker="Refunds"
  title="Refunds, EyesRhythm"
  description="EyesRhythm is free to download. Earlier paid copies can still be refunded by email."
  heading="Nothing to pay."
  lede="The current app is free, so there is no charge to refund."
>
  <p>EyesRhythm is free for macOS and Windows. There is no subscription.</p>
  <p>
    If you paid for an earlier copy and want that payment back, mail{" "}
    <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a> from the
    same email address you used then. Tell us you want a refund, and why the
    app was not worth it if you can. That helps us improve.
  </p>
  <p>
    Please give us 5 to 7 days to send the money back to your original payment
    method.
  </p>
</Legal>
